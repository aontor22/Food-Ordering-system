{
  "name": "food-ordering-system",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["front-end", "server"],
  "scripts": {
    "dev": "concurrently -n api,web -c red,green \"npm run dev -w server\" \"npm run dev -w front-end\"",
    "build": "npm run build -w front-end",
    "test": "npm test -w server",
    "db:setup": "npm run db:setup -w server",
    "start": "npm start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
