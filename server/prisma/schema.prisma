generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  googleSub String? @unique
  avatarUrl String?
  role String @default("CUSTOMER")
  isActive Boolean @default(true)
  pointsBalance Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  orders Order[]
  reviews Review[]
  loyaltyTransactions LoyaltyTransaction[]
  wishlistItems WishlistItem[]
  auditLogs AuditLog[] @relation("ActorLogs")
}

model Session {
  id String @id
  tokenHash String @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  replacedById String?
  createdAt DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Product {
  id String @id
  name String
  description String
  category String
  imageUrl String?
  imagePublicId String?
  priceCents Int
  stock Int @default(100)
  isAvailable Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderItems OrderItem[]
  reviews Review[]
  wishlistItems WishlistItem[]
  @@index([category, isAvailable])
  @@index([imagePublicId])
}


model WishlistItem {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  userId String
  productId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId, createdAt])
}

model Coupon {
  id String @id @default(cuid())
  code String @unique
  percentOff Int
  minimumCents Int @default(0)
  active Boolean @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

model LoyaltySetting {
  id String @id @default("default")
  enabled Boolean @default(true)
  pointsPerOrder Int @default(5)
  minimumRedeemPoints Int @default(50)
  pointValueCents Int @default(100)
  updatedAt DateTime @updatedAt
}

model LoyaltyTransaction {
  id String @id @default(cuid())
  type String
  points Int
  balanceAfter Int
  note String?
  createdAt DateTime @default(now())
  userId String
  orderId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([orderId, type])
  @@index([userId, createdAt])
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  status String @default("PENDING")
  paymentMethod String @default("COD")
  paymentStatus String @default("PENDING")
  subtotalCents Int
  discountCents Int @default(0)
  pointsRedeemed Int @default(0)
  pointsDiscountCents Int @default(0)
  pointsEarned Int @default(0)
  pointsAwardedAt DateTime?
  pointsRestoredAt DateTime?
  deliveryFeeCents Int
  totalCents Int
  couponCode String?
  firstName String
  lastName String
  email String
  phone String
  street String
  city String
  state String
  postalCode String
  country String
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user User @relation(fields: [userId], references: [id])
  items OrderItem[]
  reviews Review[]
  loyaltyTransactions LoyaltyTransaction[]
  payment Payment?
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Payment {
  id String @id @default(cuid())
  transactionId String @unique
  provider String
  status String @default("PENDING")
  amountCents Int
  currency String @default("USD")
  gatewaySessionId String?
  gatewayTransactionId String?
  validationId String?
  gatewayRiskLevel Int?
  gatewayRiskTitle String?
  gatewayCardType String?
  gatewayCardIssuer String?
  lastGatewayCheckAt DateTime?
  failureReason String?
  refundStatus String?
  refundReferenceId String? @unique
  refundTransactionId String? @unique
  refundAmountCents Int?
  refundReason String?
  refundRequestedAt DateTime?
  refundedAt DateTime?
  manualDestination String?
  manualSubmissions ManualPaymentSubmission[]
  attempts Int @default(0)
  lastAttemptAt DateTime?
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
}

model ManualPaymentChannel {
  id String @id @default(cuid())
  provider String
  label String
  account String
  instructions String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ManualPaymentSubmission {
  id String @id @default(cuid())
  reference String
  referenceKey String @unique
  sender String
  note String?
  amountCents Int
  currency String
  status String @default("SUBMITTED")
  reviewNote String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@index([paymentId, createdAt])
}

model OrderItem {
  id String @id @default(cuid())
  productName String
  unitPriceCents Int
  quantity Int
  lineTotalCents Int
  orderId String
  productId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  review Review?
  @@index([orderId])
}

model Review {
  id String @id @default(cuid())
  rating Int
  comment String?
  status String @default("PUBLISHED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  productId String
  orderId String
  orderItemId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
}

model RestaurantSetting {
  id String @id @default("default")
  timezone String @default("Asia/Dhaka")
  acceptingOrders Boolean @default(true)
  temporaryClosed Boolean @default(false)
  temporaryClosedReason String?
  temporaryClosedUntilLocal String?
  updatedAt DateTime @updatedAt
}

model OpeningHour {
  id String @id @default(cuid())
  dayOfWeek Int @unique
  isClosed Boolean @default(false)
  open24Hours Boolean @default(true)
  openMinute Int @default(0)
  closeMinute Int @default(0)
  updatedAt DateTime @updatedAt
}

model RestaurantClosure {
  id String @id @default(cuid())
  dateKey String @unique
  reason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())
  action String
  entity String
  entityId String?
  metadata String?
  ipAddress String?
  createdAt DateTime @default(now())
  actorId String?
  actor User? @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
}
