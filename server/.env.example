NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://tomato:tomato@localhost:5432/tomato?schema=public

JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
GOOGLE_CLIENT_ID=

PAYMENT_CURRENCY=BDT
DELIVERY_FEE_CENTS=200
ENABLE_DEMO_PAYMENTS=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tomato/products
CLOUDINARY_AUTO_MIGRATE=false

# Step 07 — transactional email (generic SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Tomato Restaurant

# Step 07 — browser Web Push. Generate with: npm run push:keys -w server
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
