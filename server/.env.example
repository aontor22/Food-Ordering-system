NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://tomato:tomato@localhost:5432/tomato?schema=public"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
# Google OAuth Web client ID. Use the same value as frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Cloudinary product image storage. Keep API_SECRET on the backend only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tomato/products
# Optional: automatically migrate legacy /food_*.png product images after server startup.
CLOUDINARY_AUTO_MIGRATE=false
# Legacy/default fallback used only when the first delivery zone is created.
# After Step 04, manage real fees in Admin → Delivery zones.
DELIVERY_FEE_CENTS=200
PAYMENT_CURRENCY=BDT
ENABLE_DEMO_PAYMENTS=true
# Add SSLCOMMERZ credentials to replace the development demo gateway.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
# SSLCOMMERZ production checklist:
# - Keep LIVE=false for sandbox testing.
# - Live mode requires PUBLIC_API_URL to be public HTTPS.
# - Live refund API may require your backend public IP to be registered with SSLCOMMERZ.
